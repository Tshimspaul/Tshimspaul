# Copy to `.env` (never commit it) and fill in your own values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://realstory:realstory@localhost:5432/realstory
CELERY_BROKER_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional overrides (defaults: <repo>/media_storage and <repo>/logs)
# MEDIA_ROOT=
# LOG_DIR=
# External provider keys arrive in later phases, e.g.:
# ANTHROPIC_API_KEY=
